# Copy to .env.local and fill in. Restart the dev server after changing.

# --- Accounts & profiles -----------------------------------------------------
# All four vars below are needed before anyone can create a profile. Miss any
# one and /profile fails in a different way, so check them together:
#
#   AUTH_SECRET missing        -> auth throws MissingSecret; every request is
#                                 treated as signed out.
#   AUTH_GOOGLE_* missing      -> src/auth.ts registers zero providers, so
#                                 sign-in is impossible and /api/profile always
#                                 answers {signedIn: false}. POST returns 401.
#   BLOB_READ_WRITE_TOKEN      -> /api/profile answers {configured: false} and
#     missing                     saving returns 503 "Profiles are not
#                                 configured."

# Required: signs the JWT session cookie (session.strategy is "jwt", so there
# is no database fallback). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Required for sign-in: Google OAuth credentials. Create an OAuth 2.0 Client ID
# (type "Web application") at https://console.cloud.google.com/apis/credentials
# and add the redirect URI:
#   http://localhost:3000/api/auth/callback/google   (and the deployed origin)
# Both must be set — src/auth.ts only registers the provider when it sees both.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required for profile storage: Vercel Blob read/write token. Get it by linking
# a Blob store to the project and running `vercel env pull`, or copy it from the
# store's page in the Vercel dashboard. A custom-named store exports a prefixed
# name instead (e.g. CARZ_READ_WRITE_TOKEN) — src/lib/blob-token.ts accepts
# either. This same token backs profiles, the leaderboard, hunt claims,
# auctions and restyle usage.
BLOB_READ_WRITE_TOKEN=

# Optional: email allowed to administer scavenger hunts.
HUNT_OWNER_EMAIL=

# --- Car identification ------------------------------------------------------
# Required: your Anthropic API key (https://console.anthropic.com/).
# Without it, the app loads but car identification returns an error.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model used for identification.
# claude-opus-4-8 = best accuracy, claude-sonnet-4-6 = faster/cheaper (default).
CAR_SPOTTER_MODEL=claude-sonnet-4-6

# Optional: trade accuracy for latency on identification.
CAR_SPOTTER_FAST=
CAR_SPOTTER_EFFORT=

# --- Restyle -----------------------------------------------------------------
# Optional: Google Gemini key for image restyling. Any of these names works
# (see src/lib/identify.ts) — GEMINI_API_KEY is the conventional one.
GEMINI_API_KEY=

# Optional: model used for restyling.
RESTYLE_MODEL=

# --- Listings ----------------------------------------------------------------
# Optional: free eBay App ID to show real "for sale" listings inline on /spot.
# Get one at https://developer.ebay.com (Application Keys). Without it, the
# listings panel falls back to marketplace search links.
EBAY_APP_ID=
